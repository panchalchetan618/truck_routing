DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173
NUM_PROXIES=0

# Leave unset to use local SQLite; docker compose builds it from the root .env
# DATABASE_URL=postgres://user:password@localhost:5432/truck_routing

OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
PHOTON_URL=https://photon.komoot.io/api/

API_ANON_THROTTLE_RATE=20/min
API_USER_THROTTLE_RATE=60/min
